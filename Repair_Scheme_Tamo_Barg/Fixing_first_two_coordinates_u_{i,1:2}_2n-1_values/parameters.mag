// ============================================================
 // Configuration for Distributed Tamo–Barg Repair Scheme Computations
 // ============================================================
 //
 // This file defines the parameters used by the manager–worker
 // architecture for computing linear exact repair schemes (LERSs)
 // of Tamo–Barg locally repairable codes via a Gröbner basis approach.
 //
 // ============================================================
 q := 2;    // Base field size: GF(q)
 t := 4;    // Extension degree: GF(q^t) over GF(q)
 k := 8;    // Code dimension
 n := 15;   // Code length
 r := 4;    // Locality parameter of the Tamo–Barg code

 s := 0;    // the erasure is on this position (number in 0,..,n-1)    
 l := 0;    // Number of prescribed zero blocks

 port_num := 21002;  // Port for manager–worker communication - must be in range 0..65535
