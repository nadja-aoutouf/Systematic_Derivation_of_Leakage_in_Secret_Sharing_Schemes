
// Parameters for the distributed Magma job
q := 3;   // base field size
t := 3;   // extension degree
k := 1;   // code dimension
n := 4;  // code length
l := 0;  // number of zero columns 
r := 1; // number of fixed values additional to the n-1 values (number inbetween 0 and n-1) 

// attention: l + r needs to be smaller than n

port_num := 28044; // must be in range 0..65535
