 // ============================================================
 // Solver for Reed–Muller Repair Schemes
 // ============================================================
 //
 // This file defines the function SetOfAllDualCodewords, which computes LERSs for generalized Reed–Muller codes over GF(q^t).
 // The repair schemes are constructed from t dual codewords. Their values at the erased coordinate form a basis of GF(q^t)
 // over GF(q), while the values at each helper coordinate span a space of dimension at most one over GF(q).
 //
 // Variable-fixing strategy: Fixing the first entry of each helper vector u_j, corresponding to n-1 prescribed values over GF(q).
 //
 // Input:
 // 	q : size of the base field K
 // 	t : extension degree
 // 	r : order of the Reed-Muller code RM(r,m)
 // 	m : number of variables
 // 	s : removed element of the support: here we are looking at the values [F!0] cat [F | a^i : i in [0..n-2] ] 
 // 		note that this can be there generelized to [F!0] cat [F | a^i : i in [0..q^t-2] ];
 //
 // Return: 
 // 	sets of t codewords (written in a t x n matrix) s.t. the codesymbols on positioon 1 are linearly independent and the codesymbols on all other positions have dimension one 
 //
 // Main steps:
 //   1. Construct the evaluation support and monomial basis.
 //   2. Construct the Reed–Muller generator matrix.
 //   3. Parameterize the repair matrix using rank-one blocks.
 //   4. Encode dual-code orthogonality over the base field.
 //   5. Add field equations and resultant constraints.
 //   6. Compute the variety of the polynomial ideal.
 //   7. Convert and verify the resulting dual codewords.
 // ============================================================

SetOfAllDualCodewords := function(q,t,r,m,n, s , list)

	K := GF(q); // Base field
	F := GF(q^t); // Finite field GF(q^t);
	a := Generator(F);

	zeta := [a^i : i in [0..t-1]]; // basis 'zeta' of F over K
	my_min_poly := MinimalPolynomial(a); // get the minimal polynomial 

	// All points of F^m, written as sequences of length m
	coeff_tuples := [ Intseq(j, q, t) : j in [0..q^t-1] ];
    field_elements := [&+[ F!coeffs[i] * zeta[i] : i in [1..t] ] : coeffs in coeff_tuples ];
    all_points := [[ field_elements[idx + 1] : idx in Intseq(j, q^t, m) ] : j in [0..(q^t)^m - 1] ];

	////////////////////////////////////////////////////////////////////////////
    // Construct the monomial basis: Monomials x_1^e_1 ... x_m^e_m with 0 <= e_i <= q^t-1 and sum e_i <= r
    ////////////////////////////////////////////////////////////////////////////
	
	if r eq 0 then
		monomials := [ [0 : i in [1..m]] ];
	else
		monomials := [
			e : e in [ Intseq(j, r+1, m) : j in [0..(r+1)^m - 1] ]
			| &+e le r
		];
	end if;

    EvalMonomial := function(P, E)
        val := F!1;
        for u in [1..m] do
            if E[u] ne 0 then
                val *:= P[u]^(E[u]);
            end if;
        end for;
        return val;
    end function;

    k := #monomials; // now the dimension needs to be calculated

    // --------------------------------------------------------
    // Select evaluation points
    // --------------------------------------------------------
	// Define evaluation points by removing the element at positions s and following

    // Remove one evaluation point if needed
    if s eq 0 or n eq (q^t)^m then
        evaluation_points := [ all_points[j] : j in [1..n]  ];
    else
        evaluation_points := [ all_points[j] : j in [1..n+1] | j ne s ];
    end if;

	// --------------------------------------------------------
    // Select polynomial ring R1
    // --------------------------------------------------------
	// Define variables for the polynomial ring R1
	v_vars := [ Sprintf("v_%o_%o", i, j) : j in [1..t] , i in [2..n]];
	u_vars := [ Sprintf("u_%o_%o", i, j) : j in [2..t] ,  i in [2..n] ];

	// Create the polynomial ring with sets of variables
	R1 := PolynomialRing(K, #v_vars + #u_vars, "elim", #v_vars); // resltant method
	AssignNames(~R1, v_vars cat u_vars); // First polynomial ring K[R121,…,Rtnt] 

	// the variables are accessible as generators of R1
	v_vars_poly := [ R1.i : i in [1..#v_vars ] ];
	u_vars_poly := [ R1.i : i in [#v_vars + 1..#v_vars + #u_vars] ];

	// --------------------------------------------------------
    // Define the matrix A over K which should include all the t codewords in F written over K
    // --------------------------------------------------------
	// Construct matrix A by horizontally concatenating t×t blocks
	blocks := [];

	// First block is the identity matrix
	Append(~blocks, IdentityMatrix(R1, t));

	// Other blocks are v_j * u_j
	for j in [2..n] do
	    u_j := Matrix(R1, t, 1, [R1!list[j-1]] cat [ R1.(#v_vars + (t-1)*(j-2)+s) : s in [1..t-1] ]);
	    v_j := Matrix(R1, 1, t, [ R1.(t*(j-2)+s) : s in [1..t] ]);
	    prod := u_j * v_j; // Result is t × t
	    submatrix := Matrix(R1, t, t, Eltseq(prod));
	    Append(~blocks, submatrix);
	end for;

	// Join all t × t blocks into one t × (n·t) matrix
	A := HorizontalJoin(blocks);

	// --------------------------------------------------------
    // Define the generator matrix of Reed-Muller(n,k) over K
    // --------------------------------------------------------
	// Define the Reed-Muller generator matrix first over F
 	G_F := Matrix(F, k, n, [ F!EvalMonomial(evaluation_points[j], monomials[i]) : j in [1..n], i in [1..k]]);

	// Convert generator matrix entries to coordinates over K
	// Each element in F is represented as a t-dimensional vector over K
	// Final matrix will be k x (n * t) over K

	// Multiplication table of F
	MultTable := [ [Eltseq(zeta[i] * zeta[j]) : j in [1..t]] : i in [1..t] ];

	// Now simulate multiplication
	Equations := [];

	for i in [1..k] do
	    for s in [1..t] do
		Eq := [R1!0 : w in [1..t]];
		for j in [1..n] do
		    g_coords := Eltseq(G_F[i,j]);
		    a_coords := [ A[s][ (j-1)*t + v ] : v in [1..t] ];
		    for u in [1..t] do
		        for v in [1..t] do
		            prod := MultTable[u][v];
		            for w in [1..t] do
		                Eq[w] +:= g_coords[u] * a_coords[v] * prod[w];
		            end for;
		        end for;
		    end for;
		end for;
		Append(~Equations, Eq);
	    end for;
	end for;

	// Extract t rows/codewords as 1 x (t*n) submatrices
	codewords_of_A  := [ Submatrix(A, i, 1, 1, t*n) : i in [1..t] ];

	M_gen_list := [];
	for i in [1..t*k] do
	    M_gen_list := M_gen_list cat Equations[i];
	end for;

	M_gen := Matrix(R1, #M_gen_list, 1, M_gen_list);

	// Construct the corresponding zero matrix 
	S_gen := Matrix(R1,  #M_gen_list, 1, [0: i in [1.. #M_gen_list]]);
	
	// =====================================================
	// Add field equations
	// =====================================================

	field_eqns := [ R1.i^q - R1.i : i in [1..#v_vars + #u_vars] ];
	M_field_eq :=  Matrix(R1, #field_eqns , 1, field_eqns);
	S_field_eq :=  Matrix(R1, #field_eqns , 1, [0 : i in [1..#field_eqns]]);

	// =====================================================
	// Build up the new system M=S over the base field that contains all equations
	// =====================================================

	seqM := Eltseq(M_field_eq) cat Eltseq(M_gen);
	M := Matrix(R1, #seqM, 1, seqM);

	seqS := Eltseq(S_field_eq) cat Eltseq(S_gen);
	S := Matrix(R1, #seqS, 1, seqS);

	// =====================================================
	// Solve the system M=S over R1
	// =====================================================

	A_sol := M - S;
	M_entries := Eltseq(A_sol);
	M_entries1:=[R1!x : x in M_entries];

	// --------------------------------------------------------
    // Resultant method in order to solve more efficently   
    // --------------------------------------------------------
	// pick 500 v-variables to eliminate 
	for idx in [1..Minimum(500, #v_vars)] do
		x := R1.idx;
		cand := [ f : f in M_entries1 | Degree(f, x) eq 1 ];
		if #cand ge 2 then
			res := Resultant(cand[1], cand[2], x);
			Append(~M_entries1, res);
		end if;
	end for;
	I := ideal<R1 | M_entries1>;
	// without Resultant method 
	//R_flat := R1;
	//I := ideal<R_flat | M_entries1>;

	// Check if the ideal is zero-dimensional and compute variety only then
	dim := Dimension(I);
	if dim gt 0 then
		return false, [], [];
	end if;

	V := Variety(I);
	if #V eq 0 then
		return false, [], [];
	end if;

	// Evaluate matrix A at each solution point
	A_evaluated := [Matrix(K, t, t*n, [Evaluate(entry, v) : entry in Eltseq(A)]): v in V];
	UniqueA := {@ A : A in A_evaluated @};

	ConvertRowFromBits := function(bits, zeta, F, t)
		return [
			&+[ bits[(i-1)*t + j] * zeta[j] : j in [1..t] ]
			: i in [1..#bits div t]
		];
	end function;

	ConvertListOfRows := function(row_list, t, zeta, F)
		return Matrix(F, [ConvertRowFromBits(row, zeta, F, t) : row in row_list]);
	end function;

	row_lists := [[Eltseq(r) : r in Rows(sol)]: sol in UniqueA];
	UniqueA_converted := [ConvertListOfRows(row_list, t, zeta, F): row_list in row_lists]; 

	// Check if codewords are duals 
	is_valid := true;
	for i in [1..#row_lists] do
		AF := ConvertListOfRows(row_lists[i], t, zeta, F); 
		Prod := G_F * Transpose(AF);
		if not forall{x : x in Eltseq(Prod) | x eq 0} then
			is_valid := false;
			break;
		end if;
	end for;

	if not is_valid then
		return false, [],  [];
	end if;

	return true, UniqueA_converted, V;
	
end function;

